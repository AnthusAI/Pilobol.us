# Local Kanbus runtime only. Stories and issues are the product.
project/.overlay/
project/.cache/
.vscode/

# Node tooling (puppeteer, used for local screenshot checks only)
node_modules/

# Generated static site. Built by `python3 web/build.py`; Amplify builds it
# at deploy time. Never commit build output.
web/dist/

# Homepage and archive listings — generated at build from article dates
# (newest first). Never hand-edit or commit these.
web/content/index.md
web/content/articles/index.md

# Python / OS cruft
__pycache__/
*.pyc
.DS_Store
dist-papyrus/

# Amplify Hosting build cache (restored by Amplify, not committed)
.amplify-cache/
web/dist-preview/

# Papyrus publication app
.next/
.uv-cache/
.npm/
cdk.out/
content-export/
amplify_outputs.json
next-env.d.ts
*.tsbuildinfo
dist/
