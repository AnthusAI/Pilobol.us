{
  "siteId": "pilobol-us",
  "stackName": "amplify-app-shell-pilobol-us-cms",
  "repository": "https://github.com/AnthusAI/Pilobol.us",
  "brand": "pilobol-us",
  "frontend": "markus-static",
  "papyrusVersion": "1.0.0-next.12",
  "cms": {
    "staging": false,
    "cognitoDomainPrefix": "papyrus-pilobol-us-cms",
    "buildComputeType": "STANDARD_8GB",
    "environment": {
      "PAPYRUS_EDITION_SLUG": "current",
      "PAPYRUS_ENABLE_CONSOLE_RESPONDER": "false",
      "PAPYRUS_ENABLE_SLACK": "false",
      "PAPYRUS_ENABLE_INBOUND_EMAIL": "false",
      "PAPYRUS_ENABLE_STORAGE_BACKUPS": "false",
      "PAPYRUS_OAUTH_REDIRECT_URLS": "http://localhost:3001/"
    }
  },
  "reader": {
    "buildCommand": "python3 reader/build.py --content content-export --out dist",
    "baseDirectory": "dist"
  },
  "github": {
    "owner": "AnthusAI",
    "repo": "Pilobol.us",
    "branches": ["main", "staging"]
  }
}
